# Copy to .env and fill in what you need. Every line is optional — meepo works with
# none of these set (local Ollama provider, no Obsidian/Discord output).

# Posts digests to a Discord channel (Settings page → Integrations → Webhooks).
DISCORD_WEBHOOK_URL=

# Which LLM summarizes items: ollama (default, local, no key) | anthropic | openai
MEEPO_LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
